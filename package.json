{
  "name": "@tsforge7/platega-sdk",
  "version": "0.0.1",
  "description": "platega sdk",
  "scripts": {
    "test": "vitest run",
    "clean": "rm -rf build",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepublish": "npm run build",
    "typecheck:watch": "tsc --noEmit -w -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mjs,json,md}\"",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "tsforge",
  "license": "ISC",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "!build/**/*.spec.*"
  ]
}
